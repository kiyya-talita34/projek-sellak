# ================= AI (otak: ide, prompt, judul, deskripsi) =================
# Pilihan: gemini | openai | mock   (mock = tanpa API key, hanya untuk uji coba pipeline)
AI_PROVIDER=mock

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI atau server kompatibel (Groq, OpenRouter, Ollama, LM Studio) lewat OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ================= YouTube Data API v3 (upload resmi, OAuth 2.0) =================
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=secrets/token.json
# true  = SIMULASI upload (tidak benar-benar mengunggah, aman untuk uji coba)
# false = upload sungguhan; siapkan client_secret.json lalu jalankan: python -m yshorts_bot youtube-auth
YOUTUBE_MOCK_UPLOAD=true
# false = worker tidak akan membuka browser login sendiri (cocok untuk server); login dulu lewat youtube-auth
YOUTUBE_INTERACTIVE_AUTH=true

# ================= Notifikasi (opsional; aktifkan juga notifications.enabled di config.json) =================
# Telegram: buat bot lewat @BotFather, ambil chat id (mis. lewat @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook Discord / Slack / URL apa pun yang menerima JSON
NOTIFY_WEBHOOK_URL=

# ================= Proteksi dashboard (opsional; WAJIB bila dashboard dibuka untuk jaringan/--host 0.0.0.0) =================
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ================= FFmpeg (opsional) =================
# Jika kosong: dicari di PATH, lalu paket imageio-ffmpeg (ikut terinstall dari requirements.txt)
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
