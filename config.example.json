{
  "niche": "Fakta menarik dunia",
  "total_videos": 10,
  "segments_per_video": 2,
  "segment_duration_seconds": 8,
  "schedule": {
    "mode": "interval",
    "interval_hours": 3,
    "start_time": "08:00",
    "specific_times": ["08:00", "12:00", "18:00", "21:00"],
    "timezone": "Asia/Jakarta"
  },
  "paths": {
    "data_dir": "data",
    "prompt_dir": "data/prompts",
    "flow_download_dir": "data/flow_downloads",
    "output_dir": "data/output",
    "failed_dir": "data/failed",
    "log_dir": "data/logs",
    "db_path": "data/yshorts.sqlite3"
  },
  "flow": {
    "provider": "manual",
    "flow_url": "https://labs.google/flow",
    "headless": false,
    "browser_channel": "chrome",
    "browser_user_data_dir": "data/browser_profile",
    "auto_submit": true,
    "login_wait_seconds": 180,
    "generation_timeout_seconds": 600,
    "wait_timeout_minutes": 1440,
    "poll_seconds": 10,
    "min_video_bytes": 1024,
    "stable_seconds": 3,
    "veo": {
      "model": "veo-3.1-generate-preview",
      "resolution": "720p",
      "aspect_ratio": "9:16",
      "duration_seconds": 8,
      "negative_prompt": "",
      "poll_seconds": 15,
      "timeout_seconds": 1200
    }
  },
  "youtube": {
    "privacy_status": "private",
    "made_for_kids": false,
    "category_id": "22",
    "default_language": "id",
    "notify_subscribers": true
  },
  "retry": {
    "max_attempts": 3,
    "base_delay_seconds": 60,
    "max_delay_seconds": 3600
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "video_bitrate": "8M",
    "audio_bitrate": "192k",
    "audio_sample_rate": 48000,
    "x264_preset": "medium",
    "fit_mode": "crop",
    "min_duration_seconds": 16,
    "pad_to_min_duration": true,
    "ffmpeg_binary": null
  },
  "worker": {
    "idle_sleep_seconds": 5,
    "heartbeat_seconds": 15,
    "reload_config": true
  }
}
